# ── Hedera — Master Agent ──────────────────────────────────────────────────────
HEDERA_OPERATOR_ID=0.0.XXXXX
HEDERA_OPERATOR_KEY=302e...
HEDERA_NETWORK=testnet

# HCS topic for immutable audit trail (run: npx tsx scripts/setup-hedera.ts)
HCS_EUDR_TOPIC_ID=0.0.XXXXX

# Specialist Agent Accounts (each receives HBAR share via MPP split)
GEOLOCATION_ACCOUNT=0.0.XXXXX
DEFORESTATION_ACCOUNT=0.0.XXXXX
AGRONOMY_ACCOUNT=0.0.XXXXX
FARM_RECORDS_ACCOUNT=0.0.XXXXX
COUNTERFEIT_ACCOUNT=0.0.XXXXX
COMPLIANCE_ACCOUNT=0.0.XXXXX
REPORT_ACCOUNT=0.0.XXXXX

# ── EUDR Scan site integration ────────────────────────────────────────────────
# Guardian fetches scan submissions from this URL via /api/internal/submissions/:id
EUDR_SCAN_API_URL=https://zigotrace.com
# Shared secret sent as x-api-key header — must match the scan site's middleware
EUDR_SCAN_API_KEY=your-shared-secret-here

# ── AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Container networking ───────────────────────────────────────────────────────
# Internal Docker network URL — UI container proxies /api/* here
# In docker-compose: http://api:3001
# In Coolify: use the service name you assign to the API container
INTERNAL_API_URL=http://api:3001

# CORS origin for the API container (set to your public UI domain in production)
CORS_ORIGIN=https://your-domain.com

# Public URL of the app (used by ACP catalog)
APP_URL=https://your-domain.com
